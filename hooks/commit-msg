#!/bin/sh
# commit-hygiene: strip AI-tool attribution from commit messages.
#
#   commit-msg <message-file>          rewrite the message in place (git calls it)
#   commit-msg --check <message-file>  exit 1 if the message WOULD change (CI)
#
# Removed:  "Generated with/by <tool>" lines, lines carrying the robot emoji
#           together with a tool name, and "Co-Authored-By:" lines for a tool
#           name or a bot/no-reply tool address.
# Kept:     human co-authors. A real person who happens to share a tool's name
#           can be allow-listed by email in .githooks/allow-coauthors (one
#           address per line, next to this hook).
# Optional: git config commit-hygiene.footer "Authored-By: your-name"
#           appends that line when missing (never in --check mode).

mode=write
if [ "$1" = "--check" ]; then mode=check; shift; fi
msg="$1"
[ -f "$msg" ] || exit 0
here=$(dirname "$0")
allow="$here/allow-coauthors"
[ -f "$allow" ] || allow=/dev/null
tmp="$msg.hygiene.$$"

awk -v allowfile="$allow" '
BEGIN {
  names = "claude|anthropic|devin|codebuff|cursor|codex|openai|chatgpt|gemini|windsurf|codeium|copilot|aider|qwen|cline|kiro"
  bots  = "noreply@anthropic[.]com|noreply@codebuff[.]com|noreply@openai[.]com|[[]bot[]]@users[.]noreply[.]github[.]com|@cognition[.]ai|devin-ai-integration"
  while ((getline a < allowfile) > 0) { gsub(/[ \t\r]/, "", a); if (a != "") allow[tolower(a)] = 1 }
}
{
  l = tolower($0)
  # "Generated with [Claude Code]", "Generated by Codex", "<robot> Generated with ..."
  if (l ~ ("generated (with|by)[^a-z]*(" names ")")) next
  if (index($0, "\360\237\244\226") > 0 && l ~ names) next
  if (l ~ /^[ \t]*co-authored-by:/) {
    email = ""
    if (match(l, /<[^>]*>/)) email = substr(l, RSTART + 1, RLENGTH - 2)
    if (email in allow) { print; next }
    if (l ~ bots) next
    if (l ~ ("^[ \t]*co-authored-by:[ \t]*(" names ")([^a-z]|$)")) next
  }
  print
}' "$msg" > "$tmp" || { rm -f "$tmp"; exit 0; }

# drop trailing blank lines the removal may leave behind
awk '{ a[NR] = $0 } END { n = NR; while (n > 0 && a[n] ~ /^[ \t]*$/) n--; for (i = 1; i <= n; i++) print a[i] }' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"

if [ "$mode" = check ]; then
  # compare ignoring trailing blank lines on the original too
  awk '{ a[NR] = $0 } END { n = NR; while (n > 0 && a[n] ~ /^[ \t]*$/) n--; for (i = 1; i <= n; i++) print a[i] }' "$msg" > "$tmp.o"
  cmp -s "$tmp.o" "$tmp"; rc=$?
  rm -f "$tmp" "$tmp.o"
  exit $rc
fi

footer=$(git config --get commit-hygiene.footer 2>/dev/null)
if [ -n "$footer" ] && ! grep -qxF "$footer" "$tmp"; then
  printf '\n%s\n' "$footer" >> "$tmp"
fi
cat "$tmp" > "$msg"
rm -f "$tmp"
exit 0
